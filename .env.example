# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Cloud Database for Vercel / Custom Domains (Vercel KV or Upstash Redis free tier)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase Cloud Database (Required for cross-device persistence and public live sync)
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Server-side Supabase credentials (optional, can be identical to above)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional external API endpoint (if hosted separately)
VITE_API_URL=

# Real Discord OAuth2 Credentials (https://discord.com/developers/applications)
# Redirect URI: <APP_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Real Google OAuth2 Credentials (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
